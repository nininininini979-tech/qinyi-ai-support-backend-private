# mock runs locally without an API key. Use openai after uploading the knowledge base.
SUPPORT_PROVIDER=mock
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_VECTOR_STORE_ID=
OPENAI_STORE=false
OPENAI_REASONING_EFFORT=low

# DeepSeek uses local knowledge retrieval because it does not expose OpenAI file_search.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local development uses memory. Vercel production uses stateless.
SESSION_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379
SESSION_TTL_SECONDS=1800

AI_SERVICE_ENABLED=true
AUTH_MODE=demo
DEMO_USER_ID=demo-user-1
DEMO_TENANT_ID=demo-tenant
PUBLIC_TENANT_ID=public-web
USER_HASH_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

MAX_MESSAGE_CHARS=2000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
REQUEST_TIMEOUT_MS=25000

# Confirm before importing a different Vault or folder.
OBSIDIAN_SOURCE_DIR=/path/to/Obsidian Vault
KB_INCLUDE_DIRS=德益处资料库,勤益印刷-询盘资料库/01-常见问题FAQ
KB_EXCLUDE_PATTERN=客户咨询|询盘分析|客户分类|销售话术|跟单|成交|个人|隐私
