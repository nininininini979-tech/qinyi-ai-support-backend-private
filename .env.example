# mock runs locally without an API key. Use openai after uploading the knowledge base.
SUPPORT_PROVIDER=mock
PORT=3002
HOST=127.0.0.1
NODE_ENV=development

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_VECTOR_STORE_ID=
OPENAI_STORE=false
OPENAI_REASONING_EFFORT=low

# DeepSeek uses local knowledge retrieval because it does not expose OpenAI file_search.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local development uses memory. Vercel production uses stateless.
SESSION_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379
SESSION_TTL_SECONDS=1800

AI_SERVICE_ENABLED=true
AUTH_MODE=demo
DEMO_USER_ID=demo-user-1
DEMO_TENANT_ID=demo-tenant
PUBLIC_TENANT_ID=public-web
# Canonical visitor origin and externally reachable API origin used by CMS pages and SEO files.
PUBLIC_SITE_URL=https://nininininini979-tech.github.io/qinyi-printing-website
PUBLIC_API_URL=http://127.0.0.1:3002
USER_HASH_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=false
ALLOWED_ORIGINS=http://127.0.0.1:4174,http://localhost:4174

MAX_MESSAGE_CHARS=2000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
REQUEST_TIMEOUT_MS=25000

# Shared A/B/C/D thought layer. Raw local archives are encrypted and stored under an ignored runtime directory.
THOUGHT_REVIEW_MAX_FAILURES=3
THOUGHT_MEMORY_ENABLED=false
THOUGHT_MEMORY_DIR=data/runtime/thought-layer
THOUGHT_MEMORY_SECRET=replace-with-a-separate-32-character-secret
THOUGHT_STAGE_CONVERSATIONS=100
THOUGHT_STAGE_DAYS=7
THOUGHT_NORMAL_DEADLINE_MS=40000
THOUGHT_PROFESSIONAL_DEADLINE_MS=55000

# Optional single-server operations core. Keep disabled on ephemeral/serverless filesystems.
OPERATIONS_ENABLED=false
# file is for local demos; production must use postgres.
OPERATIONS_STORE=file
OPERATIONS_DATA_DIR=data/runtime/operations
DATABASE_URL=
DATABASE_SSL_MODE=require
# Optional private upload root. Defaults to OPERATIONS_DATA_DIR/uploads.
UPLOAD_STORE=file
UPLOAD_DATA_DIR=
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_KEY_PREFIX=qinyi
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
OPERATIONS_ADMIN_PASSWORD=
# Optional multi-user replacement for the single admin password above. See README for the JSON schema.
OPERATIONS_USERS_JSON=
# Set true only after the 20+4 account hashes have been provisioned into the selected operations store.
OPERATIONS_ACCOUNTS_PROVISIONED=false
OPERATIONS_SESSION_SECRET=
OPERATIONS_SESSION_TTL_SECONDS=28800
OPERATIONS_DEVELOPER_TOKEN=
ORDER_SMS_PROVIDER=disabled
# Production adapter: set provider to http and connect a private SMS gateway.
ORDER_SMS_HTTP_URL=
ORDER_SMS_HTTP_TOKEN=
ORDER_SMS_TEMPLATE_ID=
ORDER_SMS_SIGN_NAME=勤益
ORDER_SMS_TIMEOUT_MS=5000

# Four isolated Agent API windows. Leave the local placeholders until four APIs are available.
# "inherit" gives B/C separate instances of the current support provider during local development.
AGENT_A_PROVIDER=mock
AGENT_A_API_KEY=
AGENT_A_BASE_URL=https://api.openai.com/v1
AGENT_A_MODEL=a-local-placeholder
AGENT_A_CHARTER_VERSION=a-charter-v1

AGENT_B_PROVIDER=inherit
AGENT_B_API_KEY=
AGENT_B_BASE_URL=https://api.openai.com/v1
AGENT_B_MODEL=b-local-placeholder
AGENT_B_CHARTER_VERSION=b-charter-v1

AGENT_C_PROVIDER=inherit
AGENT_C_API_KEY=
AGENT_C_BASE_URL=https://api.openai.com/v1
AGENT_C_MODEL=c-local-placeholder
AGENT_C_CHARTER_VERSION=c-charter-v1

AGENT_D_PROVIDER=mock
AGENT_D_API_KEY=
AGENT_D_BASE_URL=https://api.openai.com/v1
AGENT_D_MODEL=d-local-placeholder
AGENT_D_CHARTER_VERSION=d-charter-v1

# Reserved for the future non-technical operator console.
OPERATOR_MODE=auto

# Confirm before importing a different Vault or folder.
OBSIDIAN_SOURCE_DIR=/path/to/Obsidian Vault
KB_INCLUDE_DIRS=德益处资料库,勤益印刷-询盘资料库/01-常见问题FAQ
KB_EXCLUDE_PATTERN=客户咨询|询盘分析|客户分类|销售话术|跟单|成交|个人|隐私
