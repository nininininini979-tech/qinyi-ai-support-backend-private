{
  "name": "qinyi-ai-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Grounded AI customer support starter with OpenAI Responses API, Obsidian ingestion, and human handoff.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "pretest": "npm run kb:prepare",
    "test": "node --test test/*.test.js",
    "check": "npm run kb:prepare && node --check src/server.js && node --test test/*.test.js",
    "kb:prepare": "node scripts/prepare-knowledge.js",
    "kb:upload": "node scripts/upload-vector-store.js",
    "accounts:provision": "node scripts/provision-managed-accounts.js",
    "operations:migrate:postgres": "node scripts/migrate-file-operations-to-postgres.js",
    "operations:backup:file": "node scripts/backup-file-operations.js",
    "operations:backup:verify": "node scripts/verify-file-backup.js",
    "production:check": "node scripts/production-readiness.js",
    "delivery:check": "node scripts/verify-repository-delivery.js",
    "eval": "node scripts/eval-mock.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@json-editor/json-editor": "^2.17.1",
    "ajv": "^8.20.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "file-type": "^22.0.1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "openai": "^5.10.0",
    "pg": "^8.16.3",
    "redis": "^5.6.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.0"
  }
}
